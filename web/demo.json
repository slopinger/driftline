    {
      "name": "src/orbit-client.ts",
      "text": "export async function listCustomers() {\n  const response = await fetch(\"/customers?limit=100\");\n  const rows = await response.json();\n  return rows.map(customer => customer.email.toLowerCase());\n}\n\nexport const deleteCustomer = id => fetch(`/customers/${id}`, { method: \"DELETE\" });\nexport const createInvoice = amount => fetch(\"/invoices\", {method: \"POST\", body: JSON.stringify({amount})});\n"
